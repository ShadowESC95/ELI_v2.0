#!/usr/bin/env bash

# ELI capability manifest CLI
if [ "${1:-}" = "--list-capabilities" ]; then
    SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
    ROOT_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
    MANIFEST="$ROOT_DIR/capability_manifest.json"

    if [ -f "$MANIFEST" ]; then
        python3 -m json.tool "$MANIFEST"
    else
        echo "Manifest not found: $MANIFEST" >&2
        echo "Run elix normally once to generate capability_manifest.json." >&2
        exit 1
    fi

    exit 0
fi

set -euo pipefail
# Runs on the bash every Mac has (3.2) and on BSD readlink as well as GNU's.

# This script with every symlink followed, as GNU readlink -f gives it (the readlink of macOS 12.2
# and older has no -f).
_SELF="${BASH_SOURCE[0]}"
while [ -L "$_SELF" ]; do
  _link_dir="$(cd -P "$(dirname "$_SELF")" && pwd)"
  _SELF="$(readlink "$_SELF")"
  case "$_SELF" in /*) ;; *) _SELF="$_link_dir/$_SELF" ;; esac
done
_BIN_DIR="$(cd -P "$(dirname "$_SELF")" && pwd)"

if [ -d "$_BIN_DIR/../eli" ]; then
  ELI_PROJECT_ROOT="$(cd "$_BIN_DIR/.." && pwd)"
elif [ -n "${ELI_PROJECT_ROOT:-}" ] && [ -d "${ELI_PROJECT_ROOT}/eli" ]; then
  :
else
  ELI_PROJECT_ROOT="$(pwd)"
fi
export ELI_PROJECT_ROOT

# bin/elix used to save its model choice in .env.eli_v2_0, under this line, and every start then
# loaded that model over the one chosen in the app. It now saves its choice in the app's own
# settings, so the lines it left there are taken out (only those: the rest of the file stays).
_ELIX_MARK='# Selected by bin/elix model picker'
_drop_old_elix_choice() {
  local file="$1" kept
  grep -qxF "$_ELIX_MARK" "$file" 2>/dev/null || return 0
  kept="$(awk -v mark="$_ELIX_MARK" '
    $0 == mark { skip = 1; next }
    skip && /^(export[ \t]+)?(ELI_GGUF_MODEL_PATH|ELI_MODEL_PATH|ELI_MODEL|GGUF_MODEL_PATH)=/ { next }
    { skip = 0; print }
  ' "$file")" || return 1
  printf '%s\n' "$kept" > "$file" || return 1
  echo "[ELI] Took out of $file the model bin/elix had saved there; the model is kept in ELI's settings now." >&2
}

if [ -f "$ELI_PROJECT_ROOT/.env.eli_v2_0" ]; then
  _drop_old_elix_choice "$ELI_PROJECT_ROOT/.env.eli_v2_0" \
    || echo "[ELI] Could not edit $ELI_PROJECT_ROOT/.env.eli_v2_0: remove the lines under '$_ELIX_MARK', or that model keeps loading over the one chosen in the app." >&2
  # shellcheck disable=SC1090
  source "$ELI_PROJECT_ROOT/.env.eli_v2_0"
fi

export ELI_ARTIFACTS_DIR="${ELI_ARTIFACTS_DIR:-$ELI_PROJECT_ROOT/artifacts}"
export ELI_CONFIG_DIR="${ELI_CONFIG_DIR:-$ELI_PROJECT_ROOT/config}"
export ELI_DB_DIR="${ELI_DB_DIR:-$ELI_PROJECT_ROOT/artifacts/db}"
export ELI_MEMORY_DB="${ELI_MEMORY_DB:-$ELI_DB_DIR/user.sqlite3}"
export ELI_AGENT_DB="${ELI_AGENT_DB:-$ELI_DB_DIR/agent.sqlite3}"
export ELI_MEMORY_DB_PATH="${ELI_MEMORY_DB_PATH:-$ELI_DB_DIR/user.sqlite3}"
export ELI_SYSTEM_INDEX="${ELI_SYSTEM_INDEX:-$ELI_DB_DIR/system_index.sqlite3}"
export PYTHONPATH="$ELI_PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"

mkdir -p "$ELI_ARTIFACTS_DIR" "$ELI_CONFIG_DIR" "$ELI_DB_DIR"

if [ -x "$ELI_PROJECT_ROOT/.venv/bin/python" ]; then
  exec "$ELI_PROJECT_ROOT/.venv/bin/python" -m eli.gui.app "$@"
fi

exec python3 -m eli.gui.app "$@"
