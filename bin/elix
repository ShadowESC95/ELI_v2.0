#!/usr/bin/env bash
set -euo pipefail

THIS="$(readlink -f "${BASH_SOURCE[0]}")"
BIN_DIR="$(dirname "$THIS")"
ROOT="$(cd "$BIN_DIR/.." && pwd)"
REAL="$ROOT/bin/elix.real"
ENVFILE="$ROOT/.env.eli_v2_0"
PY="$ROOT/.venv/bin/python"
[ -x "$PY" ] || PY="python3"

if [ ! -x "$REAL" ]; then
  echo "❌ Missing executable launcher: $REAL" >&2
  exit 1
fi

# The model chosen here is the app's own model setting, read and saved in the settings the app reads
# when bin/elix.real starts it (its .env.eli_v2_0, then its default folders). Choosing in the app and
# choosing here are the same setting, so whichever was made last is the model that loads. This
# launcher used to keep its choice in .env.eli_v2_0, and every start then loaded it over the app's.
#   _app_model          prints the model the app has saved
#   _app_model PATH     saves PATH as the app's model
_app_model() {
  (
    export ELI_PROJECT_ROOT="$ROOT"
    if [ -f "$ENVFILE" ]; then
      # shellcheck disable=SC1090
      source "$ENVFILE"
    fi
    export ELI_CONFIG_DIR="${ELI_CONFIG_DIR:-$ROOT/config}"
    export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
    "$PY" - "$@" <<'PY'
import sys
from eli.core.runtime_settings import load_settings_from_disk, update_settings
if len(sys.argv) > 1:
    chosen = sys.argv[1]
    update_settings(provider="custom_gguf", model_path=chosen, custom_model_path=chosen,
                    gguf_model_path=chosen)
else:
    saved = load_settings_from_disk()
    print(saved.get("model_path") or saved.get("custom_model_path") or saved.get("bundled_model_path") or "")
PY
  )
}

# Do not prompt during non-interactive calls, tests, automation, or explicit skip.
if [ ! -t 0 ] || [ "${ELIX_SKIP_MODEL_PICKER:-0}" = "1" ]; then
  exec "$REAL" "$@"
fi

MODEL_DIR="${ELIX_MODEL_DIR:-$ROOT/models}"

if [ ! -d "$MODEL_DIR" ]; then
  echo "⚠️  Model directory not found: $MODEL_DIR"
  echo "Continuing normal ELI boot..."
  exec "$REAL" "$@"
fi

mapfile -t MODELS < <(
  {
    find "$MODEL_DIR" -maxdepth 2 -type f -name '*.gguf' \
      ! -path '*/hf/*' \
      ! -path '*/lora/*' \
      ! -path '*/adapters/*' \
      ! -path '*/embeddings/*' \
      ! -iname '*embed*' \
      -printf '%p
' 2>/dev/null

    find "$ROOT/models/gguf/runtime" "$ROOT/models/gguf/eli_phi" \
      -type f -name '*.gguf' \
      -printf '%p
' 2>/dev/null || true
  } | sort -u
)

if [ "${#MODELS[@]}" -eq 0 ]; then
  echo "⚠️  No .gguf models found under: $MODEL_DIR"
  echo "Continuing normal ELI boot..."
  exec "$REAL" "$@"
fi

CURRENT="$(_app_model 2>/dev/null | tail -1 || true)"

echo
echo "🧠 ELI GGUF runtime model picker"
echo "Model folder: $MODEL_DIR"
if [ -n "$CURRENT" ]; then
  echo "Current: $CURRENT"
fi
echo

i=1
for model in "${MODELS[@]}"; do
  rel="${model#$ROOT/}"
  size="$(du -h "$model" 2>/dev/null | awk '{print $1}')"
  printf '  %2d) %-9s %s\n' "$i" "$size" "$rel"
  i=$((i + 1))
done

echo
read -r -p "Choose model number, Enter for current/1, or q to cancel: " choice

case "${choice,,}" in
  q|quit|exit)
    echo "Cancelled."
    exit 130
    ;;
esac

if [ -z "$choice" ]; then
  if [ -n "$CURRENT" ] && [ -f "$CURRENT" ]; then
    SELECTED="$CURRENT"
  else
    SELECTED="${MODELS[0]}"
  fi
else
  if ! [[ "$choice" =~ ^[0-9]+$ ]]; then
    echo "❌ Invalid selection: $choice" >&2
    exit 2
  fi

  idx=$((choice - 1))
  if [ "$idx" -lt 0 ] || [ "$idx" -ge "${#MODELS[@]}" ]; then
    echo "❌ Selection out of range: $choice" >&2
    exit 2
  fi

  SELECTED="${MODELS[$idx]}"
fi

SELECTED="$(readlink -f "$SELECTED")"

echo
echo "✅ Selected model:"
echo "$SELECTED"

if [ -n "$CURRENT" ] && [ "$(readlink -f "$CURRENT" 2>/dev/null || true)" = "$SELECTED" ]; then
  :   # already the app's model
elif ! _app_model "$SELECTED" >/dev/null; then
  # The settings could not be written: this start still loads the model chosen, without keeping it.
  echo "⚠️  Could not save the model in ELI's settings; using it for this start only." >&2
  export ELI_GGUF_MODEL_PATH="$SELECTED"
fi

echo
echo "🚀 Continuing normal ELI boot..."
exec "$REAL" "$@"
